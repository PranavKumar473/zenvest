# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly ensure shell scripts and wrappers have LF endings
*.sh text eol=lf
mvnw text eol=lf
gradlew text eol=lf

# Binary files that should not be modified by git
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.jar binary
*.zip binary
*.tar.gz binary
