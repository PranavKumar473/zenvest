# ==============================================================================
# Zenvest Backend Environment Variables — PLACEHOLDERS ONLY
# Copy to backend/.env for local development. NEVER commit .env to git.
# ==============================================================================

# Active Spring profile: dev | test | prod
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL host (use 127.0.0.1 when running compose.dev.yml)
DB_HOST=127.0.0.1

# PostgreSQL port
DB_PORT=5432

# PostgreSQL database name
DB_NAME=zenvest_dev

# PostgreSQL application user (not postgres superuser)
DB_USER=zenvest_app

# PostgreSQL application user password — CHANGE BEFORE USE
DB_PASSWORD=change-me

# Redis host (use 127.0.0.1 when running compose.dev.yml)
REDIS_HOST=127.0.0.1

# Redis port
REDIS_PORT=6379

# Redis AUTH password — CHANGE BEFORE USE
REDIS_PASSWORD=change-me

# Spring Boot HTTP server port
SERVER_PORT=8080

# Actuator / management port (never exposed publicly)
MANAGEMENT_PORT=8081

# Absolute path to RSA private key PEM file for signing JWTs
JWT_PRIVATE_KEY_PATH=/path/to/private.pem

# Absolute path to RSA public key PEM file (current key)
JWT_PUBLIC_KEY_PATH=/path/to/public.pem

# Key ID for the current active JWT signing key (used in JWT header 'kid')
JWT_ACTIVE_KID=key-2026-01

# Absolute path to previous RSA public key PEM file (for rotation window)
JWT_SECONDARY_PUBLIC_KEY_PATH=/path/to/public-old.pem

# Key ID for the secondary (previous) JWT public key
JWT_SECONDARY_KID=key-2025-01

# Cookie domain for the refresh token cookie (localhost for dev)
COOKIE_DOMAIN=localhost

# Frontend origin allowed by CORS and CSRF checks
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Resend transactional email API key — CHANGE BEFORE USE
RESEND_API_KEY=change-me

# Sender address used in the 'From' header
EMAIL_FROM=noreply@zenvest.in

# Public URL of this project, used in User-Agent and email links
PROJECT_PUBLIC_URL=http://localhost:8080

# AMFI NAV all-schemes data URL (do not change unless AMFI changes it)
AMFI_NAV_ALL_URL=https://www.amfiindia.com/spages/NAVAll.txt

# MFAPI base URL for historical NAV per scheme
MFAPI_BASE_URL=https://api.mfapi.in

# Current policy version string shown in consent records
CONSENT_POLICY_VERSION=1.0
