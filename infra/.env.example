# ==============================================================================
# Zenvest Infrastructure Environment Variables — PLACEHOLDERS ONLY
# Copy to infra/.env for local development. NEVER commit .env to git.
# ==============================================================================

# PostgreSQL superuser password (used only by the postgres container at init)
POSTGRES_PASSWORD=change-me

# PostgreSQL application user (created by init script)
POSTGRES_APP_USER=zenvest_app

# PostgreSQL application user password — CHANGE BEFORE USE
POSTGRES_APP_PASSWORD=change-me

# PostgreSQL database name
POSTGRES_DB=zenvest_dev

# Redis AUTH password — must match backend REDIS_PASSWORD
REDIS_PASSWORD=change-me

# Docker image tag deployed (e.g. git SHA or 'latest')
APP_IMAGE_TAG=latest

# GHCR image name (e.g. ghcr.io/PranavKumar473/zenvest-backend)
APP_IMAGE=ghcr.io/pranavkumar473/zenvest-backend

# Caddy email for automatic TLS via Let's Encrypt (prod only)
CADDY_TLS_EMAIL=change-me@example.com

# Public hostname served by Caddy (prod only)
CADDY_HOSTNAME=zenvest.in

# Grafana Cloud Prometheus remote_write endpoint
GRAFANA_PROMETHEUS_URL=change-me

# Grafana Cloud Loki push endpoint
GRAFANA_LOKI_URL=change-me

# Grafana Cloud OTLP traces endpoint
GRAFANA_OTLP_URL=change-me

# Grafana Cloud API token (Alloy authentication) — CHANGE BEFORE USE
GRAFANA_API_TOKEN=change-me

# Oracle Object Storage S3-compatible endpoint for backups
BACKUP_S3_ENDPOINT=change-me

# Oracle Object Storage bucket name for database backups
BACKUP_S3_BUCKET=change-me

# Oracle Object Storage access key — CHANGE BEFORE USE
BACKUP_S3_ACCESS_KEY=change-me

# Oracle Object Storage secret key — CHANGE BEFORE USE
BACKUP_S3_SECRET_KEY=change-me

# age encryption public key (private key NEVER stored in repo)
BACKUP_AGE_PUBLIC_KEY=change-me

